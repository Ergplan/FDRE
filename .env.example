# Copy to .env (deploy/gce/install.sh generates one with random secrets).
POSTGRES_PASSWORD=change-me
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-48-characters
# Port the app is published on
WEB_PORT=80
# true only when the site is served over HTTPS
COOKIE_SECURE=false
# Tender intelligence: an OpenAI or Anthropic API key enables the full model reading of
# tenders (leave both blank to read in rules mode). TENDER_INTEL_PROVIDER picks one when
# both are set (blank = Anthropic first). TENDER_INTEL_MODEL names the model to use; blank
# picks one automatically from the models the key can use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TENDER_INTEL_PROVIDER=
TENDER_INTEL_MODEL=
# 1 = read tenders only with the model; a read that cannot use it fails instead of using rules.
TENDER_INTEL_REQUIRE_LLM=
