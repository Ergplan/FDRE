# Copy to .env. Never commit .env.
DATABASE_URL=postgresql+psycopg://fdre:fdre@127.0.0.1:5432/fdre
TEST_DATABASE_URL=postgresql+psycopg://fdre:fdre@127.0.0.1:5432/fdre_test
DATA_DIR=./data
SESSION_TTL_HOURS=336
SECURE_COOKIES=false
WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=600
# tender_engine (parsing, evidence, amendments). Empty URL = fixture-backed adapter, labelled as such.
TENDER_ENGINE_URL=
TENDER_ENGINE_REVIEWER=fdre-platform
TENDER_ENGINE_ADMIN_TOKEN=
TENDER_ENGINE_FIXTURES=true
# Model providers (Day 2 extraction through tender_engine; Day 6 assistant and RealTalk)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
