# Postgres connection for this deployment
DATABASE_URL=postgres://fdre:fdre@localhost:5432/fdre
# 32+ random characters; e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-of-48-characters
# Python engine (FastAPI) base URL
ENGINE_URL=http://127.0.0.1:8000
# true only when served over HTTPS
COOKIE_SECURE=false
